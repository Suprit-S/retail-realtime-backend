{
  "uid": "retail-realtime",
  "title": "Retail real-time report",
  "tags": [
    "DLMDSEDE02"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "2009-12-01T00:00:00.000Z",
    "to": "2011-12-10T00:00:00.000Z"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "description": "Reads country_revenue_5min (written by Spark Structured Streaming) through the read-only report role.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Revenue processed (GBP)",
      "description": "Sum of all aggregated windows written by Spark so far.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(revenue),0) AS revenue FROM country_revenue_5min"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replay position (event time)",
      "description": "End of the latest 5-minute window in the dataset's own time (Dec 2009 to Dec 2011).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(MAX(window_end), 'YYYY-MM-DD HH24:MI') AS replay_position FROM country_revenue_5min"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Seconds since last write",
      "description": "Freshness of the serving table. Spark writes every 30 s, so values under 90 s mean the pipeline is live.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - MAX(updated_at)))::int AS seconds FROM country_revenue_5min"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Windows x countries stored",
      "description": "Row count of country_revenue_5min.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS rows FROM country_revenue_5min"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily revenue (event time)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "description": "Aggregated 5-minute windows rolled up per day. Grows from left to right while the replay runs.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', window_start) AS time, SUM(revenue) AS revenue\nFROM country_revenue_5min\nWHERE $__timeFilter(window_start)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Top 10 countries by revenue",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "country",
        "showValue": "never",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country, SUM(revenue) AS revenue\nFROM country_revenue_5min\nGROUP BY country\nORDER BY revenue DESC\nLIMIT 10"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest aggregated windows",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyGBP"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "retail-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start, window_end, country, revenue, items, updated_at\nFROM country_revenue_5min\nORDER BY window_start DESC, revenue DESC\nLIMIT 20"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}