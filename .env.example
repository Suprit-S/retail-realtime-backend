# Copy to .env and replace every "change-me" value:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=retail
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Spark writes the aggregates as this role (SELECT/INSERT/UPDATE on one table)
POSTGRES_APP_USER=retail_app
POSTGRES_APP_PASSWORD=change-me-app
# Grafana reads the aggregates as this role (read-only, SELECT on one table)
POSTGRES_REPORT_USER=report_reader
POSTGRES_REPORT_PASSWORD=change-me-report

# --- Grafana (reporting layer, http://localhost:3000, user "admin") ---------
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Kafka / producer ---------------------------------------------------------
KAFKA_TOPIC=retail-transactions
KAFKA_PARTITIONS=3
# 3600 = one hour of shop time per second (full replay ~2-2.5 h);
# 100000 = full replay in ~11 min (used for the verified run in the README)
REPLAY_SPEEDUP=3600
DATA_FILE=/data/online_retail_ii.csv
