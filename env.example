# Copy this file to .env and adjust if needed.
# .env is gitignored on purpose — never commit real secrets.

# --- Postgres ---
POSTGRES_DB=retail
POSTGRES_APP_USER=retail_app
POSTGRES_APP_PASSWORD=change_me_app_password
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_password

# --- Kafka ---
KAFKA_TOPIC=retail-transactions
KAFKA_PARTITIONS=3

# --- Producer ---
# File must sit inside ./data (see data/README.md)
DATA_FILE=/data/online_retail_ii.csv
# How many dataset seconds are compressed into 1 real second.
# 3600 = one simulated hour of shopping passes every real second.
REPLAY_SPEEDUP=3600